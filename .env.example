# ==========================================
# GESTÃO DE PRODUTOS • EXEMPLO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha a SECRET_KEY antes de rodar em produção.
# ==========================================

ENVIRONMENT=development
SECRET_KEY=SUA_CHAVE_SECRETA_MUITO_SEGURA_AQUI_GERE_COM_SECRETS_TOKEN_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_PATH=banco_notas.db

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

MAX_UPLOAD_SIZE_MB=10
MAX_FILES_PER_UPLOAD=20

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000
